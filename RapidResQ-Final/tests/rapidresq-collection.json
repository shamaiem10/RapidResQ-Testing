{
  "info": {
    "name": "RapidResQ Integration Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "username", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "item": [

    {
      "name": "── HEALTH ──────────────────────────────",
      "item": [
        {
          "name": "TC-H-01 Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC-H-01: Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"TC-H-01: ok=true + service field\", () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.ok).to.be.true;",
                  "    pm.expect(j.service).to.eql(\"rapidresq-api\");",
                  "});",
                  "",
                  "pm.test(\"TC-H-01: Response time < 2000ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

