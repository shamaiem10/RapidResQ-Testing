{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix ./web && npm install --prefix ./backend",
  "buildCommand": "CI=false npm run build --prefix ./web",
  "outputDirectory": "web/build",
  "rewrites": [
    {
      "source": "/api/signup",
      "destination": "/api/signup"
    },
    {
      "source": "/api/login",
      "destination": "/api/login"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/**/*.js"
    },
    "api/signup.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/**/*.js"
    },
    "api/login.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/**/*.js"
    }
  }
}
