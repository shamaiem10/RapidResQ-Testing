# Local API: save as RapidResQ-Final/backend/.env OR RapidResQ-Final/.env (both are loaded).
# In Vercel: Project → Settings → Environment Variables (same names).

MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/rapidresq
PORT=5000

# Faster fail + smaller pool on Vercel (defaults: ~8s selection/connect, ~12s socket, 14s connect budget)
# MONGODB_CONNECT_BUDGET_MS=14000   # hard ceiling for mongoose.connect — avoids Vercel 60s silent hang
# MONGODB_SERVER_SELECTION_MS=8000
# MONGODB_CONNECT_TIMEOUT_MS=8000
# MONGODB_SOCKET_TIMEOUT_MS=12000
# MONGODB_WAIT_QUEUE_MS=10000
# MONGODB_QUERY_MAX_MS=10000        # User.findOne maxTimeMS on Vercel
# MONGODB_MAX_POOL_SIZE=6
# MONGODB_FORCE_IPV4=1   # try if srv/DNS flaky; Atlas also supports non-SRV URI (mongodb://host1,...,host27017)

# bcrypt cost (signup only). VERCEL defaults to ~8 rounds unless BCRYPT_SALT_ROUNDS is set locally or in Vercel.
# BCRYPT_SALT_ROUNDS=10
JWT_SECRET=change_me

# Optional
EMAIL_USER=
EMAIL_PASSWORD=
GROQ_API_KEY=

# Maps / geo (no API keys): OpenStreetMap tiles, Nominatim, Overpass —
# configured in SafetyMap.js and backend/controllers/emergencyController.js

# --- Frontend (optional) ---
# Only if the API is hosted on a different origin than the React app:
# REACT_APP_API_URL=https://your-api-host.com/api

# --- Vercel + Mongo ---
# CRITICAL: Atlas "Network Access" must allow Vercel (0.0.0.0/0 while testing works). If only your
# home IP is allowed, production will 504 while local works.
# If logs show timeout after 60s, Mongo was likely stalled (often socket/SRV/network). Tight timeouts + budget above return JSON errors sooner.
# Auth uses slim api/signup.js & api/login.js before the /api catch-all (see vercel.json).
# Login audit DB write is skipped on Vercel unless LOGIN_AUDIT=1 (saves one round-trip).
