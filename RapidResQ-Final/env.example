# Copy to backend/.env for local API (see README).
# In Vercel: Project → Settings → Environment Variables (same names).

MONGO_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/rapidresq
PORT=5000

# Faster fail + smaller pool on Vercel (avoid FUNCTION_INVOCATION_TIMEOUT while Atlas is unreachable)
# MONGODB_SERVER_SELECTION_MS=5000
# MONGODB_CONNECT_TIMEOUT_MS=7500
# MONGODB_MAX_POOL_SIZE=6
# MONGODB_FORCE_IPV4=0   # omit IPv4 forcing (default forces family 4 — helps some serverless stacks)

# bcrypt cost (signup only). VERCEL deployments default to 9 unless you override:
# BCRYPT_SALT_ROUNDS=10
JWT_SECRET=change_me

# Optional
EMAIL_USER=
EMAIL_PASSWORD=
GROQ_API_KEY=

# Maps / geo (no API keys): OpenStreetMap tiles, Nominatim, Overpass —
# configured in SafetyMap.js and backend/controllers/emergencyController.js

# --- Frontend (optional) ---
# Only if the API is hosted on a different origin than the React app:
# REACT_APP_API_URL=https://your-api-host.com/api

# --- Vercel + Mongo ---
# Auth uses dedicated slim serverless bundles: api/signup.js & api/login.js (see vercel.json
# — those paths are listed before the /api/(.*) catch-all) so signup/login bypass api/index.js.
# Atlas: Network Access must allow outbound from Vercel (often "ALLOW ACCESS FROM ANYWHERE" 0.0.0.0/0 while testing).
# Hobby plans may limit serverless duration (~10s). If signup still hits 504, upgrade plan or shorten cold path.
